{
  "name": "@instantee/authoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Instantee TypeScript authoring SDK public surface v1.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist/**",
    "src/**",
    "PUBLIC_API.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
}
