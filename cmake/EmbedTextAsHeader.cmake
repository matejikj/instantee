# Write a C++ header that embeds a UTF-8 text file as a null-terminated array.
function(instantee_embed_text_as_header input_file output_header symbol_namespace symbol_name)
  file(READ "${input_file}" _instantee_embed_hex HEX)
  if(_instantee_embed_hex STREQUAL "")
    message(FATAL_ERROR "Cannot embed empty text file: ${input_file}")
  endif()
  set(_instantee_embed_list "")
  string(LENGTH "${_instantee_embed_hex}" _instantee_embed_len)
  math(EXPR _instantee_embed_last "${_instantee_embed_len} - 1")
  foreach(_instantee_embed_i RANGE 0 ${_instantee_embed_last} 2)
    string(SUBSTRING "${_instantee_embed_hex}" ${_instantee_embed_i} 2 _instantee_embed_byte)
    string(APPEND _instantee_embed_list "static_cast<char>(0x${_instantee_embed_byte}),")
  endforeach()
  string(APPEND _instantee_embed_list "'\\0'")
  file(WRITE "${output_header}" "#pragma once\n\nnamespace ${symbol_namespace} {\n\ninline constexpr char ${symbol_name}[] = {${_instantee_embed_list}};\n\n} // namespace ${symbol_namespace}\n")
endfunction()
