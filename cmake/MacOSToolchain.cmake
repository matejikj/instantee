include("${CMAKE_CURRENT_LIST_DIR}/ToolchainLock.cmake")

foreach(query IN ITEMS sdk-path find-clang)
  if(query STREQUAL "sdk-path")
    set(arguments --sdk macosx --show-sdk-path)
  else()
    set(arguments --sdk macosx --find clang++)
  endif()
  execute_process(COMMAND /usr/bin/xcrun ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET TIMEOUT 10)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cannot resolve the selected Xcode toolchain")
  endif()
  if(query STREQUAL "sdk-path")
    set(CMAKE_OSX_SYSROOT "${output}" CACHE PATH "Selected macOS SDK")
  else()
    set(CMAKE_CXX_COMPILER "${output}" CACHE FILEPATH "Selected Clang")
    set(CMAKE_OBJCXX_COMPILER "${output}" CACHE FILEPATH "Selected Clang")
  endif()
endforeach()
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Reference architecture")
set(CMAKE_OSX_DEPLOYMENT_TARGET "${INSTANTEE_DEPLOYMENT_TARGET}" CACHE STRING "Minimum macOS")
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++")
set(CMAKE_OBJCXX_FLAGS_INIT "-stdlib=libc++ -fobjc-arc")
