      "font_size_px": 28,
      "max_width_px": 80,
      "text_role": "body"
    },
    {
      "id": "txt_su_title",
      "text": "Pythagorean relation",
      "font_asset_id": "font_display",
      "font_size_px": 48,
      "max_width_px": 980,
      "text_role": "headline"
    },
    {
      "id": "txt_su_claim",
      "text": "In a right triangle, a^2 + b^2 = c^2.",
      "font_asset_id": "font_math",
      "font_size_px": 40,
      "max_width_px": 980,
      "text_role": "headline"
    },
