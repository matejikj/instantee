  "text_runs": [
    {
      "id": "txt_ps_title",
      "text": "Pythagorean relation",
      "font_asset_id": "font_display",
      "font_size_px": 56,
      "max_width_px": 980,
      "text_role": "headline"
    },
    {
      "id": "txt_ps_prompt",
      "text": "Relate the sides of a right triangle.",
      "font_asset_id": "font_display",
      "font_size_px": 36,
      "max_width_px": 980,
      "text_role": "body"
    },
    {
      "id": "txt_co_title",
      "text": "Pythagorean relation",
      "font_asset_id": "font_display",
      "font_size_px": 48,
      "max_width_px": 980,
      "text_role": "headline"
    },
    {
      "id": "txt_co_step1",
      "text": "Draw right triangle ABC with right angle at C.",
      "font_asset_id": "font_display",
      "font_size_px": 32,
      "max_width_px": 980,
      "text_role": "body"
    },
    {
      "id": "txt_co_step2",
      "text": "Mark legs a, b and hypotenuse c.",
      "font_asset_id": "font_display",
      "font_size_px": 32,
      "max_width_px": 980,
      "text_role": "body"
    },
    {
      "id": "txt_de_title",
      "text": "Pythagorean relation",
      "font_asset_id": "font_display",
      "font_size_px": 48,
      "max_width_px": 980,
      "text_role": "headline"
    },
    {
      "id": "txt_de_eq1",
      "text": "a^2 + b^2 = c^2",
      "font_asset_id": "font_math",
      "font_size_px": 64,
      "max_width_px": 980,
      "text_role": "headline"
    },
    {
      "id": "txt_de_eq2",
      "text": "c = sqrt(a^2 + b^2)",
      "font_asset_id": "font_math",
      "font_size_px": 48,
      "max_width_px": 980,
      "text_role": "body"
    },
    {
      "id": "txt_vi_title",
      "text": "Pythagorean relation",
      "font_asset_id": "font_display",
      "font_size_px": 44,
      "max_width_px": 980,
      "text_role": "headline"
    },
    {
      "id": "txt_vi_note",
      "text": "Squares on the legs fill the square on the hypotenuse.",
      "font_asset_id": "font_display",
      "font_size_px": 28,
      "max_width_px": 980,
      "text_role": "body"
    },
    {
      "id": "txt_vi_a",
      "text": "A",
      "font_asset_id": "font_math",
      "font_size_px": 28,
      "max_width_px": 80,
      "text_role": "body"
    },
    {
      "id": "txt_vi_b",
      "text": "B",
