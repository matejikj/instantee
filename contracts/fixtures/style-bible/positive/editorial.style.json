{
  "schema_version": "1.0.0",
  "package_id": "editorial",
  "version": "1.0.0",
  "minimum_engine_version": "0.1.0",
  "tokens": {
    "colors": {
      "ink": {
        "space": "linear-rgba",
        "r": 0,
        "g": 0,
        "b": 0,
        "a": 1
      },
      "paper": {
        "space": "linear-rgba",
        "r": 0.96,
        "g": 0.94,
        "b": 0.9,
        "a": 1
      },
      "accent": {
        "space": "linear-rgba",
        "r": 0.5647,
        "g": 1,
        "b": 0,
        "a": 1
      }
    },
    "fonts": {
      "display": {
        "family": "Noto Sans",
        "role": "headline",
        "size_scale": 2
      },
      "subhead": {
        "family": "Noto Sans",
        "role": "subhead",
        "size_scale": 1.35
      },
      "body": {
        "family": "Noto Sans",
        "role": "body",
        "size_scale": 1
      },
      "caption": {
        "family": "Noto Sans",
        "role": "caption",
        "size_scale": 0.75
      },
      "mono": {
        "family": "Noto Sans Mono",
        "role": "mono",
        "size_scale": 0.85
      }
    },
    "materials": {
      "flat_ink": {
        "shader_feature": "solid-fill",
        "opacity": 1,
        "parameters": {
          "grain": 0
        }
      },
      "halftone_panel": {
        "shader_feature": "halftone",
        "opacity": 0.92,
        "parameters": {
          "dot_scale": 1.25
        }
      },
      "acid_block": {
        "shader_feature": "solid-fill",
        "opacity": 1,
        "parameters": {
          "grain": 0.05
        }
      }
    },
    "spacing": {
      "gutter": {
        "px": 24
      },
      "margin": {
        "px": 48
      },
      "stack": {
        "px": 16
      },
      "column_gap": {
        "px": 32
      },
      "accent_bar": {
        "px": 12
      }
    },
    "motion": {
      "headline_reveal": {
        "ease": "ease_out",
        "duration_frames": 18,
        "intensity": 0.8,
        "stagger_frames": 2
      },
      "panel_settle": {
        "ease": "spring",
        "duration_frames": 24,
        "intensity": 0.55,
        "stagger_frames": 0
      },
      "accent_slam": {
        "ease": "ease_in",
        "duration_frames": 10,
        "intensity": 1,
        "stagger_frames": 0
      }
    },
    "camera": {
      "editorial_push": {
        "framing": "push_in",
        "ease": "ease_in_out"
      },
      "hold": {
        "framing": "static",
        "ease": "linear"
      }
    },
    "safe_area": {
      "mode": "reels_overlay",
      "top_px": 120,
      "bottom_px": 220,
      "left_px": 32,
      "right_px": 32
    }
  }
}
