    "materials": {
      "paper_sheet": {
        "shader_feature": "paper-sheet",
        "opacity": 1,
        "parameters": {
          "fiber": 0.4,
          "fold": 0.15,
          "roughness": 0.35,
          "shadow_bias": 0.06,
          "edge_thickness": 0.04
