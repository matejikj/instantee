{
  "schema_version": "1.0.0",
  "package_id": "scientific-notebook",
  "version": "1.0.0",
  "minimum_engine_version": "0.1.0",
  "tokens": {
    "colors": {
      "cream": {
        "space": "linear-rgba",
        "r": 0.97,
        "g": 0.94,
        "b": 0.88,
        "a": 1
      },
      "page": {
        "space": "linear-rgba",
        "r": 0.97,
        "g": 0.94,
        "b": 0.88,
        "a": 1
      },
      "ink_blue": {
        "space": "linear-rgba",
        "r": 0.06,
        "g": 0.16,
        "b": 0.42,
        "a": 1
      },
      "ink": {
        "space": "linear-rgba",
        "r": 0.06,
        "g": 0.16,
        "b": 0.42,
        "a": 1
      },
      "yellow": {
        "space": "linear-rgba",
        "r": 0.95,
        "g": 0.82,
        "b": 0.18,
        "a": 1
      },
      "lavender": {
        "space": "linear-rgba",
        "r": 0.62,
        "g": 0.52,
        "b": 0.86,
        "a": 1
      },
      "grid": {
        "space": "linear-rgba",
        "r": 0.55,
        "g": 0.7,
        "b": 0.85,
        "a": 0.35
      }
    },
    "fonts": {
      "display": {
        "family": "DejaVu Sans",
        "role": "headline",
        "size_scale": 1.75
      },
      "subhead": {
        "family": "DejaVu Sans",
        "role": "subhead",
        "size_scale": 1.3
      },
      "body": {
        "family": "DejaVu Sans",
        "role": "body",
        "size_scale": 1
      },
      "caption": {
        "family": "DejaVu Sans",
        "role": "caption",
        "size_scale": 0.85
      },
      "equation": {
        "family": "DejaVu Sans",
        "role": "mono",
        "size_scale": 1.1
      }
    },
    "materials": {
      "pen_ink": {
        "shader_feature": "ink-stroke",
        "opacity": 1,
        "parameters": {
          "bleed": 0.12
        }
      },
      "notebook_grid": {
        "shader_feature": "grid-paper",
        "opacity": 1,
        "parameters": {
          "cell_px": 24
        }
      },
      "highlighter": {
        "shader_feature": "solid-fill",
        "opacity": 0.55,
        "parameters": {
          "grain": 0.02
        }
      },
      "sticky_note": {
        "shader_feature": "solid-fill",
        "opacity": 1,
        "parameters": {
          "grain": 0.04
        }
      }
    },
    "spacing": {
      "margin": {
        "px": 48
      },
      "note_gap": {
        "px": 16
      },
      "equation_pad": {
        "px": 20
      },
      "step_stack": {
        "px": 28
      },
      "margin_rule": {
        "px": 8
      }
    },
    "motion": {
      "ink_reveal": {
        "ease": "linear",
        "duration_frames": 36,
        "intensity": 0.65,
        "stagger_frames": 2
      },
      "step_reveal": {
        "ease": "ease_out",
        "duration_frames": 28,
        "intensity": 0.55,
        "stagger_frames": 4
      },
      "highlight_draw": {
        "ease": "ease_in_out",
        "duration_frames": 22,
        "intensity": 0.7,
        "stagger_frames": 0
      },
      "diagram_settle": {
        "ease": "ease_out",
        "duration_frames": 30,
        "intensity": 0.45,
        "stagger_frames": 0
      }
    },
    "camera": {
      "page_hold": {
        "framing": "static",
        "ease": "linear"
      },
      "detail_push": {
        "framing": "push_in",
        "ease": "ease_out"
      },
      "step_pan": {
        "framing": "pan",
        "ease": "ease_in_out"
      }
    },
    "safe_area": {
      "mode": "full_frame",
      "top_px": 48,
      "bottom_px": 64,
      "left_px": 40,
      "right_px": 40
    }
  }
}
