{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instantee.dev/contracts/schemas/asset-lockfile-v1.schema.json",
  "title": "Instantee Asset Lockfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "target_feature_profile",
    "style_packages",
    "assets",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "compiler_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "target_feature_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "style_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/\\\\]{1,128}$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "sha256", "media_type", "role"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/\\\\]{1,128}$"
          },
          "uri": {
            "type": "string",
            "pattern": "^assets/[a-zA-Z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": { "type": "string", "minLength": 3 },
          "role": { "enum": ["font", "image", "other"] }
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
