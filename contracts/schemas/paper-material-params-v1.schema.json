{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instantee.dev/contracts/schemas/paper-material-params-v1.schema.json",
  "title": "Instantee Paper Material Params v1",
  "description": "Versioned paper-sheet material knobs shared by Style Bible parameters and render-core. Ranges are closed; omitted fields use model defaults. No GPU handles or style-package names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "parameters"
  ],
  "properties": {
    "model_version": {
      "const": "1.0.0"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fiber": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color_wash": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edge_thickness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shadow_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "normal_variation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiber",
        "roughness",
        "color_wash",
        "edge_thickness",
        "shadow_bias",
        "normal_variation",
        "seed"
      ],
      "properties": {
        "fiber": {
          "const": 0.4
        },
        "roughness": {
          "const": 0.35
        },
        "color_wash": {
          "const": 0.12
        },
        "edge_thickness": {
          "const": 0.04
        },
        "shadow_bias": {
          "const": 0.06
        },
        "normal_variation": {
          "const": 0.15
        },
        "seed": {
          "const": 1
        }
      }
    }
  }
}
