{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instantee.dev/contracts/schemas/release-asset-lock-v1.schema.json",
  "title": "Instantee Release Asset Lock v1",
  "description": "Repository-wide lock of fonts, textures, blueprints, Style Bible documents, nested style locks, licenses and recorded build flags for offline reproducibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lock_id",
    "compiler_version",
    "target_feature_profile",
    "build_flags",
    "style_packages",
    "entries",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "lock_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "compiler_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "target_feature_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "build_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 128 },
          "value": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "style_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/\\\\]{1,128}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "role", "license"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/\\\\]{1,128}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "font",
              "texture",
              "blueprint",
              "style_bible",
              "style_lock",
              "license",
              "pin"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "license_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
          }
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
