{
  "name": "instantee",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.15.0",
    "npm": "11.14.0"
  },
  "packageManager": "npm@11.14.0",
  "scripts": {
    "check:toolchain": "node tools/toolchain/check-node.cjs",
    "build:authoring": "npm run build --workspaces",
    "check:authoring": "npm run typecheck --workspaces",
    "contracts:generate": "node tools/contracts/generate_types.mjs",
    "contracts:check": "node tools/contracts/check_contracts.mjs",
    "contracts:test": "node tools/contracts/test_contracts.mjs",
    "test:authoring": "npm run build:authoring && node tools/contracts/test_authoring_sdk.mjs && node tools/contracts/check_authoring_public_api.mjs && node authoring/examples/three-styles/main.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "authoring/packages/*"
  ]
}
